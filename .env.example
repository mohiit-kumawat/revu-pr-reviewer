# ==============================================================================
# revu - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and fill in the actual values.
# IMPORTANT: Never commit your real secrets, tokens, or private keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Connection string for your PostgreSQL database (Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth & GitHub OAuth)
# ------------------------------------------------------------------------------
# Secret used by Better Auth to sign session tokens and cookies (min 32 chars)
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
# Application canonical base URL
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth credentials (created in GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# ------------------------------------------------------------------------------
# 3. GitHub App Integration (Octokit, Webhooks & Codebase Access)
# ------------------------------------------------------------------------------
# Numeric ID of the installed GitHub App
GITHUB_APP_ID="123456"
# App slug name
GITHUB_APP_NAME="revu-pr-reviewer"
# Public URL to install the GitHub App
NEXT_PUBLIC_GITHUB_PUBLIC_LINK="https://github.com/apps/revu-pr-reviewer"

# GitHub App Private Key (.pem format). Escaped newlines (\n) supported at runtime.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# Webhook Secret used to verify payload signatures from GitHub webhook events
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
GITHUB_APP_WEBHOOK_SECRET="your_github_webhook_secret"

# ------------------------------------------------------------------------------
# 4. AI Code Review (OpenRouter)
# ------------------------------------------------------------------------------
# OpenRouter API key for generating AI pull-request reviews
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"

# ------------------------------------------------------------------------------
# 5. Vector Database (Pinecone)
# ------------------------------------------------------------------------------
# Pinecone API credentials for storing and querying codebase context embeddings
PINECONE_API_KEY="pcsk_your_pinecone_api_key"
PINECONE_INDEX="revu-pr-reviewer"

# ------------------------------------------------------------------------------
# 6. Billing & Subscriptions (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Razorpay Subscription Plan ID & Webhook Secret
RAZORPAY_PLAN_ID="plan_your_plan_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 7. Background Event Functions (Inngest)
# ------------------------------------------------------------------------------
# Set to 1 for local development without connecting to Inngest Cloud
INNGEST_DEV=1
# Optional: Inngest signing key for production webhook verification
# INNGEST_SIGNING_KEY="signkey-prod-..."
