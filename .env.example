# ==========================================
# Database (PostgreSQL / Neon / Prisma)
# ==========================================
# Connection string with connection pooling (e.g., Neon Pooler)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct / Unpooled connection string (optional, if required for Prisma migrations)
# DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==========================================
# Authentication (Better Auth & GitHub OAuth)
# ==========================================
# Generate a secure random secret (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET="your_better_auth_secret_here"
# Application URL (http://localhost:3000 for local dev or your ngrok/production domain)
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials (used for user sign-in)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# ==========================================
# GitHub App Configuration (PR Reviews & Bot)
# ==========================================
GITHUB_APP_ID="your_github_app_id"
GITHUB_APP_NAME="your_github_app_name"
NEXT_PUBLIC_GITHUB_PUBLIC_LINK="https://github.com/apps/your-github-app-name"

# Private key generated from your GitHub App settings (paste full RSA private key with \n or in quotes)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook secret configured in your GitHub App
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"

# ==========================================
# AI Provider (OpenRouter)
# ==========================================
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"

# ==========================================
# Vector Database (Pinecone)
# ==========================================
PINECONE_INDEX="revu-pr-reviewer"
PINECONE_API_KEY="pcsk_your_pinecone_api_key_here"

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_PLAN_ID="plan_your_subscription_plan_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ==========================================
# Inngest (Background Queues & Jobs - Optional)
# ==========================================
# INNGEST_EVENT_KEY="your_inngest_event_key"
# INNGEST_SIGNING_KEY="your_inngest_signing_key"

